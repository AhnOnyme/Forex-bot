# --- OANDA (compte practice/paper) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice     # practice | live (doit rester practice par defaut)
OANDA_GRANULARITY=M15          # M1, M5, M15, H1, ...
OANDA_CANDLE_COUNT=50

# --- Cerveau LLM (OpenRouter, modele Qwen) ---
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Notifications Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News / calendrier economique (flux ForexFactory, pas de cle requise) ---
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# --- Comportement de l'app ---
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
INSTRUMENT=EUR_USD
