# --- OANDA (compte practice/paper) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice     # practice | live (doit rester practice par defaut)
OANDA_GRANULARITY=M15          # M1, M5, M15, H1, ...
OANDA_CANDLE_COUNT=50

# --- Cerveau LLM (OpenRouter, modele Qwen) ---
LLM_API_KEY=
LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CANDLE_WINDOW=20            # nb de bougies envoyees dans le prompt

# --- Notifications Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News / calendrier economique (flux ForexFactory, pas de cle requise) ---
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# --- Gestion du risque (etape 4) ---
RISK_STOP_LOSS_PCT=0.005        # distance du stop-loss par rapport au prix d'entree (0.5%)
RISK_PER_TRADE_PCT=0.01         # part max du solde du compte risquee par trade (1%)
RISK_NEWS_BLACKOUT_MINUTES=15   # pas de nouvel ordre autour d'une news a fort impact

# --- Comportement de l'app ---
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
INSTRUMENT=EUR_USD
